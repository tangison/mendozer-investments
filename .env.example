# Canonical public URL. Change this single value at cutover; do not hardcode domains in components.
NEXT_PUBLIC_SITE_URL=https://mendozer.tangison.com

# Approved server-side Resend delivery configuration.
# These values are server-only. Never prefix them with NEXT_PUBLIC and never commit credentials.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=contact@mendozer.com
